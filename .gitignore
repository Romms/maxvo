# Machine-local git worktrees created for isolation:"worktree" background agents.
.claude/worktrees/

# Obsidian workspace/cache state is machine-specific; config & plugins are kept.
# The vault is the whole repo root (open the repo root in Obsidian, not vault/).
.obsidian/workspace*.json
.obsidian/cache
.trash/
